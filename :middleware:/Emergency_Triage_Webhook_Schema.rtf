\f0\fs24 \cf0 \{\
  "$schema": "http://json-schema.org/draft-07/schema#",\
  "title": "EmergencyTriageWebhookPayload",\
  "type": "object",\
  "required": [\
    "popia_consent",\
    "PatientName",\
    "PatientNumber",\
    "symptoms",\
    "triage_status",\
    "AppointmentDate",\
    "timestamp",\
    "patient_address"\
  ],\
  "properties": \{\
    "popia_consent": \{\
      "type": "string",\
      "enum": ["true", "false"],\
      "description": "POPIA privacy consent status confirmed by the patient",\
      "example": "true"\
    \},\
    "PatientName": \{\
      "type": "string",\
      "minLength": 2,\
      "description": "Full name of the patient",\
      "example": "Qhayiya Mani"\
    \},\
    "PatientNumber": \{\
      "type": "string",\
      "pattern": "^0[6-8]\\\\d\{8\}$",\
      "description": "10-digit South African mobile contact phone number",\
      "example": "0646698797"\
    \},\
    "symptoms": \{\
      "type": "string",\
      "description": "Reported clinical symptoms during bot intake",\
      "example": "have a severe chest pain"\
    \},\
    "triage_status": \{\
      "type": "string",\
      "enum": \'93STANDARD\'94, \'93RESCHEDULE\'94, \'93CRITICAL / EMERGENCY\'94, \'93CANCEL\'94],\
      "description": "Assigned triage severity level triggering priority alert",\
      "example": "CRITICAL / EMERGENCY"\
    \},\
    "AppointmentDate": \{\
      "type": "string",\
      "description": "Scheduled appointment date or emergency override flag",\
      "example": "N/A - Emergency Triage"\
    \},\
    "timestamp": \{\
      "type": "string",\
      "pattern": "^\\\\d\{4\}-\\\\d\{2\}-\\\\d\{2\} \\\\d\{2\}:\\\\d\{2\}:\\\\d\{2\}$",\
      "description": "Payload generation timestamp (yyyy-MM-dd HH:mm:ss SAST)",\
      "example": "2026-11-10 20:09:00"\
    \},\
    "patient_address": \{\
      "type": "string",\
      "description": "Physical address or campus location of the patient",\
      "example": "UWC Main Campus, Bellville"\
    \}\
  \}\
\}\
}